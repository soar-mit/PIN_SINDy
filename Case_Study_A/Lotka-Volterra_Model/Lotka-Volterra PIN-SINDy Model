# create training data:
def true_forcing(t, x):
    dx = .7*x[0] - .5*x[1]*x[0]
    dy = -.3*x[1] + .1*x[1]*x[0]
    return [dx, dy]

def prior_forcing(t, x):
    dx = x[0] + x[1]*x[0]
    dy = x[1] + x[1]*x[0]
    return [dx, dy]





