
from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
from SINDyPySource import SINDY, theta, dmethods

# select what output you would like to see:
add_noise = False
plot_results = True
plot_error = False
X0 = (1, 1, 1) # initial conditions to run PIN-SINDy on.

#create model:

def true_equation(t, X):
    # define constants:
    sigma = 10
    rho = 28
    beta = 8/3
    alpha = 0 #3/10
    gamma = 0
    kappa = 3/100

    dx = sigma*(X[1]-X[0]) + alpha*X[2]*X[1] - kappa*X[0]**2
    dy = X[0]*(rho - X[2]) - X[1] + gamma*X[2]
    dz = X[0]*X[1] - beta*X[2] - kappa*X[1]
    return np.array([dx, dy, dz])

sigma = 10
rho = 28
beta = 8/3
alpha = 0 #3/10
gamma = 0
kappa = 3/100

true_coef = np.array([[-sigma, sigma, 0, -kappa, 0, 0, 0, alpha, 0],
    [rho, -1, gamma, 0, 0, -1, 0, 0, 0], [0, -kappa, -beta, 0, 1, 0, 0, 0, 0]])
fi = np.array([[-sigma, sigma, 0, 0, 0, 0, 0, 0, 0], [rho, -1, 0, 0, 0, -1, 0, 0, 0],
                       [0, 0, -beta, 0, 1, 0, 0, 0, 0]])


t_span = (0, 20)
t = np.linspace(0, 20, 1400)
y0 = (1, 1, 1)

x, y, z = integrate.solve_ivp(true_equation, t_span, y0, method='LSODA', t_eval=t).y
X = np.array([x, y, z])

if add_noise:
    noise = np.random.normal(0, 1.5, X.shape)
    X = X + noise

#create PIN-SINDy model

dmethod = dmethods(X, t)
theta_instance = theta(X, 2)
lbd = 95.41
sindy = SINDY(dmethod, theta_instance, X, lbd, norm_optimization=True, threshold=.1)

model = sindy.model(fi=fi)
sol = sindy.simulate(t_span, X0, t, fi=fi)

solx, soly, solz = sol.y

#find coefficient difference:

sindy_coef = sindy.get_coef()
coef_dif = np.abs(true_coef - sindy_coef)

coef_dif = np.round(coef_dif, 2)

#generate results:
if plot_results:
    if y0 != X0:
        x, y, z = integrate.solve_ivp(true_coef, t_span, X0, method="LSODA", t_eval=t)

    fig = plt.figure()
    axs = GridSpec(3, 2, width_ratios=[1, 1])
    axs1 = fig.add_subplot(axs[0, 1])
    axs2= fig.add_subplot(axs[1, 1], sharex=axs1)
    axs3 = fig.add_subplot(axs[2, 1], sharex=axs1)
    axs0 = fig.add_subplot(axs[:, 0], projection='3d')

    axs0.plot(solx, soly, solz, color="blue")
    axs0.plot(x, y, z, zdir='z', color="orange", linestyle="dashed")

    axs1.plot(t, solx, label="PIN-SINDy x")
    axs1.plot(t, x, label='x data', linestyle='dashed')

    axs2.plot(t, soly, label="PIN-SINDy y")
    axs2.plot(t, y, label='y data', linestyle='dashed')

    axs3.plot(t, solz, label="PIN-SINDy z")
    axs3.plot(t, z, label='z data', linestyle='dashed')

    plt.suptitle(f"PIN-SINDy Lorentz Model \n coefficient difference: {coef_dif} \n lbd = {lbd}")
    axs0.legend()
    plt.tight_layout()
    plt.grid()
    plt.show()

if plot_error:
    lbd_space = np.logspace(-7, 3, 50)
    zeta = []

    min_error = np.inf
    opt_lbd = 0
    for lbd in lbd_space:
        sindy = SINDY(dmethod, theta_instance, X, lbd)
        model = sindy.model(fi)
        sol = sindy.simulate(t_span, y0, t, fi=fi)
        sindy_coef = sindy.get_coef()
        zeta_term = np.linalg.norm(sindy_coef - true_coef, 2)/ np.linalg.norm(sindy_coef+fi, 2)
        if zeta_term < min_error:
            min_error = zeta_term
            opt_lbd = lbd
        zeta.append(zeta_term)

    min_error = np.min(zeta)
    plt.plot(lbd_space, zeta, color='orange')
    plt.plot(opt_lbd, min_error, color="blue")
    plt.xlabel('lambda values')
    plt.ylabel('coefficient error (scaled)')
    plt.title(f'PIN-SINDy Lorentz System Error (opt lbd: {opt_lbd})')
    plt.grid()
    plt.show()
