        zeta_sindy_3.append(abs((coef_sindy_l[0, 4] - true_coef[0,4])/coef_sindy_l[0,4]))
        zeta_pin_3.append(abs((coef_pin_l[0,4] - true_coef[0,4])/coef_pin_l[0,4]))

