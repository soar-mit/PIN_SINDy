from SINDyPySource import SINDY, dmethods
from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec


# Goal: to find the density constant and synthetic atmospheric density constant in a
#  hypothetical satellite orbit using SINDy and PIN-SINDy.
#step 0: determine which output you would like to see.
plot_true_vs_prior = False
print_true_coef = True
opt_lbd_coef = True
plot_error = True
plot_model = True
opt_lbd_sim = True
print_sindy_coef = True
print_pin_coef = True
opt_lbd_ind_coef = True

num_orbits = 4
points_per_orbit = 6

#step 1: define true and prior equation  ## using km instead of m.
G = 6.6743e-11 ## e-11
M = 1/G
R = 1
J2 = 1.08e-3 # perturbation coefficient
r0 = 1.5


def orbital_equation(t, X):
    # X = [r theta, phi, dr, dtheta, dphi]
    if X[0] < R:
        raise ValueError("Satellite went inside earth.")

    r = X[0]
    thet = X[1]
    phi = X[2]
    dr = X[3]
    dthet = X[4]
    dphi = X[5]

    ddr = (
        r*(dthet**2 + np.sin(thet)**2*dphi**2)
        - G*M/r**2
        + 3*G*M*J2*R**2*(3*np.cos(thet)**2 - 1)/(2*r**4)
    )

    ddtheta = (
    -2*dr*dthet/r
    + np.sin(thet)*np.cos(thet)*dphi**2
    + 3*G*M*J2*R**2*np.sin(thet)*np.cos(thet)/r**5
    )

    ddphi = -2*dr*dphi/r - 2*dthet*dphi/np.tan(thet)

    return [X[3], X[4], X[5], ddr, ddtheta, ddphi]

print("step 1 complete.")
# step 2: find initial conditions:

theta0 = np.deg2rad(60)

X0 = [r0, theta0, 0, 0, 0, ((G*M/(r0)**3)**.5)/np.sin(theta0)]

#calculate period:
T = 2*np.pi*(X0[0]**3 / (G*M))**(1/2)
t_span = (0, num_orbits*(int(T)))
t = np.linspace(t_span[0], t_span[1], points_per_orbit*(int(T)))

r, thet, phi, dr , dthet, dphi = integrate.solve_ivp(orbital_equation, t_span, X0, t_eval=t,  method="LSODA").y
X = np.array([r, thet, phi, dr, dthet, dphi])

x = r*np.cos(phi)*np.sin(thet)
y = r*np.sin(phi)*np.sin(thet)
z = r*np.cos(thet)

print("step 2 complete.")


#Step 3: Create theta matrix
theta_lib = np.zeros((10, points_per_orbit*(int(T))))
theta_lib[0,:] = r*dthet**2
theta_lib[1,:] = r*np.sin(thet)**2*dphi**2
theta_lib[2,:] = r**(-2)
theta_lib[3,:] = np.cos(thet)**2/r**4
theta_lib[4,:] = r**(-4)
theta_lib[5,:] = dr*dthet/r
theta_lib[6,:] = np.sin(thet)*np.cos(thet)*dphi**2
theta_lib[7,:] = np.sin(thet)*np.cos(thet)/r**5
theta_lib[8,:] = dr*dphi/r
theta_lib[9,:] = dthet*dphi/np.tan(thet)


print("step 3 complete.")
#Step 4: create PIN-SINDy and SINDy Models

#true coefficients. Doesn't include xdot, ydot, zdot terms.
true_coef = np.zeros((3,10))
true_coef[0, 0] = 1
true_coef[0, 1] = 1
true_coef[0, 2] = -G*M
true_coef[0, 3] = 9*G*M*J2*R**2/2
true_coef[0, 4] = -3*G*M*J2*R**2/2

true_coef[1, 5] = -2
true_coef[1, 6] = 1
true_coef[1, 7] = 3*G*M*R**2*J2

true_coef[2, 8] = -2
true_coef[2, 9] = -2

#prior coefficient matrix fi. Doesn't include J2 oblation terms or coef.
fi = np.zeros((3,10))
fi[0, 0] = 1
fi[0, 1] = 1
fi[0, 2] = -G*M

fi[1, 5] = -2
fi[1, 6] = 1

fi[2, 8] = -2
fi[2, 9] = -2

dmethod = dmethods(X[0:3], t)
sindy = SINDY(dmethod, X[0:3], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib, lbd=.0204,
              norm_optimization=True, derivative="second derivative second order", regressor="lstsq")
sindy_pin = SINDY(dmethod, X[0:3], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib, lbd=1,
                  norm_optimization=True, derivative="second derivative second order", regressor="lstsq")

coef_sindy = np.round(sindy.model()['coef'], 2)
coef_pin = np.round(sindy_pin.model(fi)['coef'], 2)

print("step 4 complete.")

# step 5: simulate function

def simulate_orbit(coef_s, coef_p):

    def sindy_model(t, X):

        r = X[0]
        thet = X[1]
        phi = X[2]
        dr = X[3]
        dthet = X[4]
        dphi = X[5]

        theta_lib = np.array([
        r*dthet**2,
        r*np.sin(thet)**2*dphi**2,
        r**-2,
        np.cos(thet)**2/r**4,
        r**-4,
        dr*dthet/r,
        np.sin(thet)*np.cos(thet)*dphi**2,
        np.sin(thet)*np.cos(thet)/r**5,
        dr*dphi/r,
        dthet*dphi/np.tan(thet)
        ])

        forcing = coef_s @ theta_lib

        return [X[3], X[4], X[5], forcing[0], forcing[1], forcing[2]]

    sol_sindy = integrate.solve_ivp(sindy_model, t_span, X0, t_eval=t).y

    def pin_model(t, X):

        r = X[0]
        thet = X[1]
        phi = X[2]
        dr = X[3]
        dthet = X[4]
        dphi = X[5]

        theta_lib = np.array([
                r*dthet**2,
                r*np.sin(thet)**2*dphi**2,
                r**-2,
                np.cos(thet)**2/r**4,
                r**-4,
                dr*dthet/r,
                np.sin(thet)*np.cos(thet)*dphi**2,
                np.sin(thet)*np.cos(thet)/r**5,
                dr*dphi/r,
                dthet*dphi/np.tan(thet)
        ])

        forcing = coef_p @ theta_lib

        return [X[3], X[4], X[5], forcing[0], forcing[1], forcing[2]]


    sol_pin = integrate.solve_ivp(pin_model, t_span, X0, t_eval=t).y

    return {"sindy":sol_sindy, "pin":sol_pin}

print("step 5 complete.")

if plot_true_vs_prior:
    def prior_equation(t, X):

        if X[0] < R:
            raise ValueError("Satellite went inside earth.")

        r = X[0]
        thet = X[1]
        phi = X[2]
        dr = X[3]
        dthet = X[4]
        dphi = X[5]

        ddr = (
        r*(dthet**2 + np.sin(thet)**2*dphi**2)
        - G*M/r**2)

        ddtheta = (
        -2*dr*dthet/r
        + np.sin(thet)*np.cos(thet)*dphi**2)

        ddphi = -2*dr*dphi/r - 2*dthet*dphi/np.tan(thet)

        return [X[3], X[4], X[5], ddr, ddtheta, ddphi]



    Xprior = integrate.solve_ivp(prior_equation, t_span, X0, method="LSODA", t_eval=t).y

    xp = Xprior[0]*np.cos(Xprior[2])*np.sin(Xprior[1])
    yp = Xprior[0]*np.sin(Xprior[1])*np.sin(Xprior[2])
    zp = Xprior[0]*np.cos(Xprior[1])

    fig = plt.figure()
    axs = GridSpec(3, 2, width_ratios=[1, 1])
    axs_x = fig.add_subplot(axs[0, 1])
    axs_y = fig.add_subplot(axs[1, 1], sharex=axs_x)
    axs_z = fig.add_subplot(axs[2, 1], sharex=axs_x)
    axs0 = fig.add_subplot(axs[:, 0], projection='3d')

    axs_x.plot(t, x, color="khaki")
    axs_x.plot(t, xp, linestyle="dashed", color="thistle")
    axs_x.set_ylabel('x')

    axs_y.plot(t, y, color="khaki")
    axs_y.plot(t, yp, linestyle="dashed", color="thistle")
    axs_y.set_ylabel('y')

    axs_z.plot(t, z, color="khaki")
    axs_z.plot(t, zp, linestyle="dashed", color="thistle")
    axs_z.set_ylabel('z')
    axs_z.set_xlabel('t')

    axs0.plot(x, y, z, label="true", color="khaki")
    axs0.plot(xp, yp, zp, label="prior", linestyle="dashed", color="thistle")

    fig.legend()
    plt.show()

if opt_lbd_coef:
    lbds = np.logspace(-8, 1, 100)
    zeta_sindy = []
    zeta_pin = []

    min_error_sindy = np.inf
    opt_lbd_sindy = 0

    min_error_pin = np.inf
    opt_lbd_pin = 0

    for lbd in lbds:
        sindy_l = SINDY(dmethod, X[3:], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib,
                        norm_optimization=True, lbd=lbd, derivative="second derivative second order", regressor = "lstsq")
        coef_sindy_l = sindy_l.model()['coef']
        coef_pin_l = sindy_l.model(fi)['coef']
        sindy_norm = np.linalg.norm(coef_sindy_l, 2)

        if sindy_norm == 0:
            sindy_norm = 1
        zeta_term_sindy = np.linalg.norm(coef_sindy_l - true_coef, 2) / sindy_norm
        zeta_sindy.append(zeta_term_sindy)

        if zeta_term_sindy <= min_error_sindy:
            min_error_sindy = zeta_term_sindy
            opt_lbd_sindy = lbd

        pin_norm = np.linalg.norm(coef_pin_l, 2)

        if pin_norm == 0 :
            pin_norm = 1

        zeta_term_pin = np.linalg.norm(coef_pin_l - true_coef, 2) / pin_norm
        zeta_pin.append(zeta_term_pin)

        if zeta_term_pin <= min_error_pin:
            min_error_pin = zeta_term_pin
            opt_lbd_pin = lbd

    zeta_sindy = np.array(zeta_sindy)
    zeta_pin = np.array(zeta_pin)

    plt.plot(lbds, zeta_sindy, color="lightcoral")
    plt.plot(opt_lbd_sindy, min_error_sindy, marker='o', markersize=5, color="firebrick")
    plt.xscale('log')
    plt.ylabel('normalized coefficient error.')
    plt.annotate(
        f'pin min: {min_error_pin:.3g}\nλ={opt_lbd_pin:.3g}',
        xy=(opt_lbd_pin, min_error_pin),
        xytext=(-100, 25), textcoords='offset points',
        fontsize=8, color='royalblue',
        arrowprops=dict(arrowstyle='->', color='royalblue', lw=1)
    )
    plt.annotate(
            f'sindy min: {min_error_sindy:.3g}\nλ={opt_lbd_sindy:.3g}',
            xy=(opt_lbd_sindy, min_error_sindy),
            xytext=(15, 25), textcoords='offset points',
            fontsize=8, color='firebrick',
            arrowprops=dict(arrowstyle='->', color='firebrick', lw=1)
        )
    plt.plot(lbds, zeta_pin)
    plt.plot(opt_lbd_pin, min_error_pin, marker='o', markersize=5, color="royalblue")
    plt.xlabel('λ values')


    plt.show()

if plot_model:

    sol = simulate_orbit(coef_sindy, coef_pin)

    sol_sindy = sol["sindy"][:3]
