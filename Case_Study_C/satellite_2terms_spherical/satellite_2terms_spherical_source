from SINDyPySource import SINDY, dmethods
from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec


# Goal: to find the density constant and synthetic atmospheric density constant in a
#  hypothetical satellite orbit using SINDy and PIN-SINDy.
#step 0: determine which output you would like to see.
plot_true_vs_prior = False
print_true_coef = True
opt_lbd_coef = True
plot_error = True
plot_model = True
opt_lbd_sim = True
print_sindy_coef = True
print_pin_coef = True

#step 1: define true and prior equation

def orbital_equation(t, X):
    # X = [r theta, phi, dr, dtheta, dphi]
    M = 1/(6.6743e-11) #5.972e24 # mass of earth
    G = 6.6743e-11 # gravitational constant
    R = 1 # radius of eart
    J2 = 1.08263e0 # perturbation coefficient
    if X[0] < R:
        raise ValueError("Satellite went inside earth.")

    r = X[0]
    thet = X[1]
    phi = X[2]
    dr = X[3]
    dthet = X[4]
    dphi = X[5]

    ddr = (
        r*(dthet**2 + np.sin(thet)**2*dphi**2)
        - G*M/r**2
        + 3*G*M*J2*R**2*(3*np.cos(thet)**2 - 1)/(2*r**4)
    )

    ddtheta = (
    -2*dr*dthet/r
    + np.sin(thet)*np.cos(thet)*dphi**2
    + 3*G*M*J2*R**2*np.sin(thet)*np.cos(thet)/r**5
    )

    ddphi = -2*dr*dphi/r - 2*dthet*dphi/np.tan(thet)

    return [X[3], X[4], X[5], ddr, ddtheta, ddphi]

print("step 1 complete.")
# step 2: find initial conditions:

G = 6.6743e-11
M = 1/G #5.972e24
R = 1 #6.371e6
J2 = 1.08263e0

r0 = 2.5 #7.078e6
theta0 = np.deg2rad(60)

X0 = [r0, theta0, 0, 0, 0, ((G*M/(r0)**3)**.5)/np.sin(theta0)]

#calculate period:
T = 2*np.pi*(X0[0]**3 / (G*M))**(1/2)
t_span = (0, 5*(int(T)))
t = np.linspace(t_span[0], t_span[1], 15*(int(T)))

r, thet, phi, dr , dthet, dphi = integrate.solve_ivp(orbital_equation, t_span, X0, method='LSODA', t_eval=t).y
X = np.array([r, thet, phi, dr, dthet, dphi])

x = r*np.cos(phi)*np.sin(thet)
y = r*np.sin(phi)*np.sin(thet)
z = r*np.cos(thet)

print("step 2 complete.")


#Step 3: Create theta matrix
theta_lib = np.zeros((10, 15*(int(T))))
theta_lib[0,:] = r*dthet**2
theta_lib[1,:] = r*np.sin(thet)**2*dphi**2
theta_lib[2,:] = r**(-2)
theta_lib[3,:] = np.cos(thet)**2/r**4
theta_lib[4,:] = r**(-4)
theta_lib[5,:] = dr*dthet/r
theta_lib[6,:] = np.sin(thet)*np.cos(thet)*dphi**2
theta_lib[7,:] = np.sin(thet)*np.cos(thet)/r**5
theta_lib[8,:] = dr*dphi/r
theta_lib[9,:] = dthet*dphi/np.tan(thet)


print("step 3 complete.")
#Step 4: create PIN-SINDy and SINDy Models

#true coefficients. Doesn't include xdot, ydot, zdot terms.
true_coef = np.zeros((3,10))
true_coef[0, 0] = 1
true_coef[0, 1] = 1
true_coef[0, 2] = -G*M
true_coef[0, 3] = 9*G*M*J2*R**2/2
true_coef[0, 4] = -3*G*M*J2*R**2/2

true_coef[1, 5] = -2
true_coef[1, 6] = 1
true_coef[1, 7] = 3*G*M*R**2*J2

true_coef[2, 8] = -2
true_coef[2, 9] = -2

#prior coefficient matrix fi. Doesn't include J2 oblation terms or coef.
fi = np.zeros((3,10))
fi[0, 0] = 1
fi[0, 1] = 1
fi[0, 2] = -G*M

fi[1, 5] = -2
fi[1, 6] = 1

fi[2, 8] = -2
fi[2, 9] = -2

dmethod = dmethods(X[0:3], t)
sindy_pin = SINDY(dmethod, X[0:3], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib, lbd=1.26,
                  norm_optimization=False, derivative="second derivative second order", regressor="lstsq", max_iter=5)
sindy = SINDY(dmethod, X[0:3], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib, lbd=1.53,
              norm_optimization=False, derivative="second derivative second order", regressor="lstsq", max_iter=5)

coef_sindy = sindy.model()['coef']
coef_pin = sindy_pin.model(fi)['coef']

print("step 4 complete.")

# step 5: simulate function

def simulate_orbit(coef_s, coef_p):

    def sindy_model(t, X):

        r = X[0]
        thet = X[1]
        phi = X[2]
        dr = X[3]
        dthet = X[4]
        dphi = X[5]

        theta_lib = np.array([
        r*dthet**2,
        r*np.sin(thet)**2*dphi**2,
        r**-2,
        np.cos(thet)**2/r**4,
        r**-4,
        dr*dthet/r,
        np.sin(thet)*np.cos(thet)*dphi**2,
        np.sin(thet)*np.cos(thet)/r**5,
        dr*dphi/r,
        dthet*dphi/np.tan(thet)
        ])

        forcing = coef_s @ theta_lib

        return [X[3], X[4], X[5], forcing[0], forcing[1], forcing[2]]

    sol_sindy = integrate.solve_ivp(sindy_model, t_span, X0, method="LSODA", t_eval=t).y

    def pin_model(t, X):

        r = X[0]
        thet = X[1]
        phi = X[2]
        dr = X[3]
        dthet = X[4]
        dphi = X[5]

        theta_lib = np.array([
                r*dthet**2,
                r*np.sin(thet)**2*dphi**2,
                r**-2,
                np.cos(thet)**2/r**4,
                r**-4,
                dr*dthet/r,
                np.sin(thet)*np.cos(thet)*dphi**2,
                np.sin(thet)*np.cos(thet)/r**5,
                dr*dphi/r,
                dthet*dphi/np.tan(thet)
        ])

        forcing = coef_p @ theta_lib

        return [X[3], X[4], X[5], forcing[0], forcing[1], forcing[2]]


    sol_pin = integrate.solve_ivp(pin_model, t_span, X0, method="LSODA", t_eval=t).y

    return {"sindy":sol_sindy, "pin":sol_pin}

print("step 5 complete.")

if plot_true_vs_prior:
    def prior_equation(t, X):
        G = 6.6743e-11
        M = 1/G #5.972e24
        R = 1 #6.371e6 # radius of earth

        if X[0] < R:
            raise ValueError("Satellite went inside earth.")

        r = X[0]
        thet = X[1]
        phi = X[2]
        dr = X[3]
        dthet = X[4]
        dphi = X[5]

        ddr = (
        r*(dthet**2 + np.sin(thet)**2*dphi**2)
        - G*M/r**2)

        ddtheta = (
        -2*dr*dthet/r
        + np.sin(thet)*np.cos(thet)*dphi**2)

        ddphi = -2*dr*dphi/r - 2*dthet*dphi/np.tan(thet)

        return [X[3], X[4], X[5], ddr, ddtheta, ddphi]



    Xprior = integrate.solve_ivp(prior_equation, t_span, X0, method="LSODA", t_eval=t).y

    xp = Xprior[0]*np.cos(Xprior[2])*np.sin(Xprior[1])
    yp = Xprior[0]*np.sin(Xprior[1])*np.sin(Xprior[2])
    zp = Xprior[0]*np.cos(Xprior[1])

    fig = plt.figure()
    axs = GridSpec(3, 2, width_ratios=[1, 1])
    axs_x = fig.add_subplot(axs[0, 1])
    axs_y = fig.add_subplot(axs[1, 1], sharex=axs_x)
    axs_z = fig.add_subplot(axs[2, 1], sharex=axs_x)
    axs0 = fig.add_subplot(axs[:, 0], projection='3d')

    axs_x.plot(t, x)
    axs_x.plot(t, xp, linestyle="dashed")
    axs_x.set_ylabel('x')

    axs_y.plot(t, y)
    axs_y.plot(t, yp, linestyle="dashed")
    axs_y.set_ylabel('y')

    axs_z.plot(t, z)
    axs_z.plot(t, zp, linestyle="dashed")
    axs_z.set_ylabel('z')
    axs_z.set_xlabel('t')

    axs0.plot(x, y, z, label="true")
    axs0.plot(xp, yp, zp, label="prior", linestyle="dashed")

    fig.legend()
    plt.show()

if opt_lbd_coef:
    lbds = np.logspace(-3, 0, 50)
    zeta_sindy = []
    zeta_pin = []

    min_error_sindy = np.inf
    opt_lbd_sindy = 0

    min_error_pin = np.inf
    opt_lbd_pin = 0

    for lbd in lbds:
        sindy_l = SINDY(dmethod, X[3:], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib,
                        norm_optimization=False, lbd=lbd, derivative="second derivative second order", regressor = "lstsq")
        coef_sindy_l = sindy_l.model()['coef']
        coef_pin_l = sindy_l.model(fi)['coef']
        sindy_norm = np.linalg.norm(coef_sindy_l, 2)

        if sindy_norm != 0:
            zeta_term_sindy = np.linalg.norm(coef_sindy_l - true_coef, 2) / sindy_norm
            zeta_sindy.append(zeta_term_sindy)

            if zeta_term_sindy <= min_error_sindy:
                min_error_sindy = zeta_term_sindy
                opt_lbd_sindy = lbd
        else:
            print(f'lambda causing sindy error: {lbd}.')
            zeta_sindy.append(1000)

        pin_norm = np.linalg.norm(coef_pin_l, 2)

        if pin_norm != 0 :
            zeta_term_pin = np.linalg.norm(coef_pin_l - true_coef, 2) / pin_norm
            zeta_pin.append(zeta_term_pin)

            if zeta_term_pin <= min_error_pin:
                min_error_pin = zeta_term_pin
                opt_lbd_pin = lbd
        else:
            print(f'lambda causing pin sindy error: {lbd}.')
            zeta_pin.append(1000)

    zeta_sindy = np.array(zeta_sindy)
    zeta_pin = np.array(zeta_pin)

    fix, axs = plt.subplots(2, 1)
    axs[0].plot(lbds, zeta_sindy)
    axs[0].plot(opt_lbd_sindy, min_error_sindy, marker='o', markersize=12)
    axs[0].set_xscale('log')
    axs[0].set_ylabel('normalized sindy coefficient error.')
    axs[0].set_title(f'optimal lambda value is: {opt_lbd_sindy} with minimal error {min_error_sindy}.')

    axs[1].plot(lbds, zeta_pin)
    axs[1].plot(opt_lbd_pin, min_error_pin, marker='o', markersize=12)
    axs[1].set_xlabel('lambda values')
    axs[1].set_xscale('log')
    axs[1].set_ylabel('normalized pin-sindy coefficient error.')
    axs[1].set_title(f'optimal lambda value is: {opt_lbd_pin} with minimal error {min_error_pin}.')

    plt.show()

if plot_model:

    sol = simulate_orbit(coef_sindy, coef_pin)

    sol_sindy = sol["sindy"][:3]
    sol_pin = sol["pin"][:3]

    fig = plt.figure()
    ax0 = fig.add_subplot(121, projection='3d')
    ax1 = fig.add_subplot(122, projection='3d')

    xs = sol_sindy[0]*np.cos(sol_sindy[2])*np.sin(sol_sindy[1])
    ys = sol_sindy[0]*np.sin(sol_sindy[2])*np.sin(sol_sindy[1])
    zs = sol_sindy[0]*np.cos(sol_sindy[1])

    xp = sol_pin[0]*np.cos(sol_pin[2])*np.sin(sol_pin[1])
    yp = sol_pin[0]*np.sin(sol_pin[2])*np.sin(sol_pin[1])
    zp = sol_pin[0]*np.cos(sol_pin[1])


    ax0.plot(xs, ys, zs, label="SINDy model")
    ax0.plot(x, y, z, label="actual", linestyle="dashed")
    ax0.legend()

    ax1.plot(xp, yp, zp, label="PIN-SINDy model")
    ax1.plot(x, y, z, label="actual", linestyle="dashed")
    ax1.legend()
    plt.tight_layout()
    plt.show()

if plot_error:
    rs_error = abs((sol_sindy[0] - X[0]) / X[0])
    thetas_error = abs((sol_sindy[1] - X[1]) / X[1])
    phis_error = abs((sol_sindy[2] - X[2]) / X[2])

    rp_error = abs((sol_pin[0] - X[0]) / X[0])
    thetap_error = abs((sol_pin[1] - X[1]) / X[1])
    phip_error = abs((sol_sindy[2] - X[2]) / X[2])

    fig, axs = plt.subplots(3, 2)

    axs[0, 0].plot(t, rs_error)
    axs[0, 0].set_ylabel("sindy r error")

    axs[1, 0].plot(t, thetas_error)
    axs[1, 0].set_ylabel("sindy theta error")

    axs[2, 0].plot(t, phis_error)
    axs[2, 0].set_ylabel("sindy phi  error")
    axs[2, 0].set_xlabel("t (sec)")

    axs[0, 1].plot(t, rp_error)
    axs[0, 1].set_ylabel("pin-sindy r error")

    axs[1, 1].plot(t, thetap_error)
    axs[1, 1].set_ylabel("pin-sindy theta error")

    axs[2, 1].plot(t, phip_error)
    axs[2, 1].set_ylabel("pin-sindy phi error")
    axs[2, 1].set_xlabel("t (sec)")

    plt.tight_layout()
    plt.show()

if opt_lbd_sim == True:
    lbds = np.logspace(-3, 1, 50)
    lbds = list(lbds)
    lbds_copy = lbds.copy()
    zeta_sindy = []
    zeta_pin = []

    min_error_sindy = np.inf
    opt_lbd_sindy = 0

    min_error_pin = np.inf
    opt_lbd_pin = 0

    thet[thet==0] = 1
    phi[phi==0] = 1


    for lbd in lbds:
        sindy_l2 = SINDY(dmethod, X[3:], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib,
                         norm_optimization=False, lbd=lbd, derivative="second derivative second order", regressor="lstsq")
        coef_sindy_l2 = sindy_l2.model()['coef']
        coef_pin_l2 = sindy_l2.model(fi)['coef']

        sim_l2 = simulate_orbit(coef_sindy_l2, coef_pin_l2)
        sr, sthet, sphi = sim_l2["sindy"][:3]
        pr, pthet, pphi = sim_l2["pin"][:3]

        if len(sr) == len(r):
            sr_error = np.average(np.abs((sr-r)/r))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(pr) == len(r):
            pr_error = np.average(np.abs((pr - r)/r))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(sthet) == len(thet):
            sthet_error = np.average(np.abs((sthet-thet)/thet))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(pthet) == len(thet):
            pthet_error = np.average(np.abs((pthet - thet)/thet))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(sphi) == len(phi):
            sphi_error = np.average(np.abs((sphi-phi)/phi))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(pphi) == len(phi):
            pphi_error = np.average(np.abs((pphi - phi)/phi))
        else:
            lbds_copy.remove(lbd)
            continue


        s_error = np.average([sr_error, sthet_error, sphi_error])
        zeta_sindy.append(s_error)

        p_error = np.average([pr_error, pthet_error, pphi_error])
        zeta_pin.append(p_error)

        if s_error <= min_error_sindy:
                min_error_sindy = s_error
                opt_lbd_sindy = lbd

        if p_error <= min_error_pin:
                min_error_pin = p_error
                opt_lbd_pin = lbd

    zeta_sindy = np.array(zeta_sindy)
    zeta_pin = np.array(zeta_pin)

    fix, axs = plt.subplots(2, 1)
    axs[0].plot(lbds_copy, zeta_sindy)
    axs[0].plot(opt_lbd_sindy, min_error_sindy, marker='o', markersize=12)
    axs[0].set_xscale('log')
    axs[0].set_ylabel('average sindy model error.')
    axs[0].set_title(f'optimal lambda value is: {opt_lbd_sindy} with minimal error {min_error_sindy}.')

    axs[1].plot(lbds_copy, zeta_pin)
    axs[1].plot(opt_lbd_pin, min_error_pin, marker='o', markersize=12)
    axs[1].set_xlabel('lambda values')
    axs[1].set_xscale('log')
    axs[1].set_ylabel('average pin-sindy model error.')
    axs[1].set_title(f'optimal lambda value is: {opt_lbd_pin} with minimal error {min_error_pin}.')

    plt.show()

