
from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
from SINDy_Source_Code.SINDyPySource import SINDY, theta, dmethod

# select what output you would like to see:
add_noise = False
plot_results = False
plot_error = False
X0 = (1, 1, 1) # initial conditions for SINDy to predict.

#create model:

def true_equation(t, X):
    # define constants:
    sigma = 10
    rho = 28
    beta = 8/3
    alpha = 3/10
    gamma = -1
    kappa = 3/100

    dx = sigma*(X[1]-X[0]) + alpha*X[2]*X[1] - kappa*X[0]**2
    dy = X[0]*(rho - X[2]) - X[1] + gamma*X[2]
    dz = X[0]*X[1] - beta*X[2] - kappa*X[1]
    return np.array([dx, dy, dz])

sigma = 10
rho = 28
beta = 8/3
alpha = 3/10
gamma = -1
kappa = 3/100

true_coef = np.array([[-sigma, sigma, 0, -kappa, 0, 0, 0, alpha, 0],
    [rho, -1, gamma, 0, 0, -1, 0, 0, 0], [0, -kappa, -beta, 0, 1, 0, 0, 0, 0]])


t_span = (0, 20)
t = np.linspace(0, 20, 1400)
y0 = (1, 1, 1)

x, y, z = integrate.solve_ivp(true_equation, t_span, y0, str='LSODA', t_eval=t).y
X = np.array([x, y, z])

if add_noise:
    noise = np.random.normal(0, 1.5, X.shape)
    X = X + noise

#create SINDy model

dmethod = dmethods(X, t)
theta_instance = theta(X, 2)
lbd = 1e-1
sindy = SINDY(dmethod, theta_instance, X, lbd)

model = sindy.model()
sol = sindy.simulate(t_span, y0, t)

solx, soly, solz = sol.y

#generate results:
if plot_results:

    #find coefficient difference:

    coef_dif = np.abs(true_coef - sindy.get_coef())

    coef_dif[coef_dif<= .02] = 0

    coef_dif = np.round(coef_dif, 2)

    # generate true simulation:
    if X0 != y0:
        x, y, z = integrate.solve_ivp(true_equation, t_span, X0, method="LSODA", t_eval=t).y

    fig = plt.figure()
    axs = GridSpec(3, 2, width_ratios=[1, 1])
    axs1 = fig.add_subplot(axs[0, 1])
    axs2= fig.add_subplot(axs[1, 1], sharex=axs1)
    axs3 = fig.add_subplot(axs[2, 1], sharex=axs1)
    axs0 = fig.add_subplot(axs[:, 0], projection='3d')

    axs0.plot(solx, soly, solz)
    axs0.plot(X[0], X[1], X[2], linestyle='dashed')

    axs1.plot(t, solx, label="SINDy x")
    axs1.plot(t, X[0], label='x data', linestyle='dashed')

    axs2.plot(t, soly, label="SINDy y")
    axs2.plot(t, X[1], label='y data', linestyle='dashed')

    axs3.plot(t, solz, label="SINDy z")
    axs3.plot(t, X[2], label='z data', linestyle='dashed')

    plt.suptitle(f"SINDy Lorentz Model \n coefficient difference: {coef_dif} \n lbd = {lbd}")
    plt.legend()
    plt.tight_layout()
    plt.grid()
    plt.show()

if plot_error:
    lbd_space = np.logspace(-7, 0, 50)
    zeta = []

    for lbd in lbd_space:
        sindy = SINDY(dmethod, theta_instance, X, lbd)
        model = sindy.model()
        sol = sindy.simulate(t_span, y0, t)
        sindy_coef = sindy.get_coef()

        zeta_term = np.linalg.norm(sindy_coef - true_coef, 2)/ np.linalg.norm(sindy_coef, 2)
        zeta.append(zeta_term)

    zeta = np.array(zeta)

    plt.plot(lbd_space, zeta)
    plt.xlabel('lambda values')
    plt.ylabel('coefficient error (scaled)')
    plt.title('SINDy Lorentz System Error')
    plt.grid()
    plt.show()
