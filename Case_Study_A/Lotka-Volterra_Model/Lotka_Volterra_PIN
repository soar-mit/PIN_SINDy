class theta:

    def __init__(self, var_list, order):
        """
        var_list:
            shape = (num_state_variables, num_samples)
        """
        self.var_list = np.array(var_list, dtype=np.float64)
        self.order = order

    def get_order(self):
        return self.order

    def get_powers(self):
        """
        Returns:
            powers matrix of shape:
            (num_features, num_state_variables)
        """

        I = len(self.var_list)
        K = self.order

        pwrs = []

        for k in range(K + 1):
            for powers in itertools.combinations_with_replacement(range(I), k):

                pwr = [0] * I

                for i in powers:
                    pwr[i] += 1

                pwrs.append(pwr)

        return np.array(pwrs, dtype=np.float64)

    def library(self):
        """
        Returns theta library with shape:

            (num_samples, num_features)

        rows    -> time samples
        columns -> candidate functions
        """

        var_list = self.var_list
        pwrs = self.get_powers()

        terms = []

        for p in pwrs:

            term = np.ones_like(var_list[0], dtype=np.float64)

            for i in range(len(var_list)):
                term *= var_list[i] ** p[i]

            terms.append(term)

        # shape becomes:
        # (num_features, num_samples)
        library = np.array(terms)

        # remove constant term
        library = library[1:]

        return library


class dmethods:

    def __init__(self, x, t):

        self.x = np.array(x, dtype=np.float64)
        self.t = np.array(t, dtype=np.float64)

        self.dt = t[1] - t[0]

    def differential(self, var):

        smooth_var = savgol_filter(
            var,
            window_length=11,
            polyorder=3
        )

        return np.gradient(smooth_var, self.dt)

    def forward_difference(self):
        """
        Returns:

            shape = (num_state_variables, num_samples)
        """

        derivatives = []

        for var in self.x:
            derivatives.append(self.differential(var))

        derivatives = np.array(derivatives)

        derivatives = np.clip(
            derivatives,
            -1e6,
            1e6
        )

        return derivatives


class STLSQ:

    def __init__(self, diff, theta_lib, lbd=0.01):

        if lbd < 0:
            raise ValueError("threshold must be positive")

        self.diff = np.array(diff, dtype=np.float64)

        # shape:
        # (num_samples, num_features)
        self.theta_lib = np.array(theta_lib, dtype=np.float64)

        self.lbd = lbd

    def sparse_regression(self):
        """
        Returns coefficient matrix:

            shape = (num_state_variables, num_features)
        """
        theta_lib = self.theta_lib.T
        model = Lasso(
            alpha=self.lbd,
            fit_intercept=False
        )

        coef = []

        for i in range(len(self.diff)):

            y = self.diff[i]

            model.fit(theta_lib, y)

            coef.append(model.coef_)

        return np.array(coef)

    def sparse_regression_pin(self, fi):
        """
        fi shape:
            (num_state_variables, num_features)
        """

        fi = np.array(fi, dtype=np.float64)

        model = Lasso(
            alpha=self.lbd,
            fit_intercept=False
        )

        correction_coef = []

        for i in range(len(self.diff)):

            prior_prediction = fi[i]@self.theta_lib ### shape is (1, 5) @ (5, 5000) ---> shape is  (1, 5000)

            residual = self.diff[i] - prior_prediction

            model.fit(self.theta_lib.T, residual) ## shape is theta_lib: (5, 5000)

            correction_coef.append(model.coef_)
        return np.array(correction_coef)


class SINDY:

    def __init__(self, dmethod, theta_instance, var_list, lbd=0.01):

        self.f = dmethod.forward_difference()

        # shape:
        # (num_samples, num_features)
        self.theta_lib = theta_instance.library()

        self.var_list = np.array(var_list)

        self.order = theta_instance.get_order()

        self.theta = theta_instance

        self.lbd = lbd

        self.dmethod = dmethod

    def model(self):

        s = STLSQ(
            self.f,
            self.theta_lib,
            self.lbd
        )

        coef = s.sparse_regression()

        model = []

        for i in range(len(coef)):

            prediction = coef[i] @ self.theta_lib  # (1, 5) @ (5, 5000)

            model.append(prediction)

        self.coef = coef

        return {
            'coef': coef,
            'model': model
        }

    def model_pin_sindy(self, fi):

        s = STLSQ(
            self.f,
            self.theta_lib,
            self.lbd
        )

        correction_coef = s.sparse_regression_pin(fi)

        final_coef = np.array(fi) + correction_coef

        model = []

        for i in range(len(final_coef)):

            prediction =  final_coef[i] @ self.theta_lib

            model.append(prediction)

        self.coef = final_coef

        return {
            'coef': final_coef,
            'model': model
        }

    def get_coef(self):

        if not hasattr(self, "coef"):
            raise ValueError("Run model() first")

        return np.round(self.coef, 2)

    def simulate(self, t_span, u0, t_data):

        if not hasattr(self, "coef"):
            raise ValueError("Create model before simulation")

        coef = self.coef

        self.t_span = t_span
        self.u0 = u0
        self.t_data = t_data

        pwrs = self.theta.get_powers()

        def f(t, y):

            theta_vals = []

            for p in pwrs:

                term = 1.0

                for i in range(len(y)):
                    term *= y[i] ** p[i]

                theta_vals.append(term)

            theta_vals = np.array(theta_vals)

            # remove constant term
            theta_vals = theta_vals[1:]

            forcing = np.array([
                theta_vals @ coef_vector
                for coef_vector in coef
            ])

            return forcing

        sol = integrate.solve_ivp(
            f,
            t_span,
            u0,
            method="LSODA",
            t_eval=t_data
        )

        return sol

    def best_lbd(self, X, true_coef, fi=None):
        x, y = X
        lbd_guess = np.logspace(-6, 1, 50)
        min_err = np.inf
        lbd_opt = 0
        for lbd in lbd_guess:
            sindy = SINDY(self.dmethod, self.theta, self.var_list, lbd=lbd)
            if fi == None:
                model = sindy.model()
                coef_sindy = sindy.get_coef()
                coef_err = np.mean((true_coef - coef_sindy)**2)
            else:
                model = sindy.model_pin_sindy(fi)
                coef_sindy = sindy.get_coef()
                coef_err = np.mean((true_coef - coef_sindy)**2)

            if coef_err < min_err:
                min_err = coef_err
                lbd_opt = lbd
        final_sindy = SINDY(self.dmethod, self.theta, self.var_list, lbd=lbd_opt)
        if fi == None:

            final_model = final_sindy.model()
        else:
            final_model = final_sindy.model_pin_sindy(fi)
        final_sol = final_sindy.simulate(self.t_span, self.u0, self.t_data).y
        return {'model':final_model, 'min_err': min_err, 'lbd': lbd_opt, 'sol': final_sol}



