from scipy import integrate
import numpy as np
from SINDyPySource import theta, dmethods, SINDY
import matplotlib.pyplot as plt
from scipy.optimize import minimize

# create training data:
def true_forcing(t, x):
    dx = x[0] + x[1] + .2*x[0]**2
    dy = -x[0] + .1*x[1] + x[0]*x[1]
    return [dx, dy]

def prior_forcing(t, x):
    dx = x[0] + x[1]
    dy = -x[0]
    return [dx, dy]

x0 = [2.1, 1]

t = np.linspace(0, 5, 500)
t_span = (0, 5)

true_sol = integrate.solve_ivp(true_forcing, t_span, x0, t_eval=t)
x, y = true_sol.y
trueT = true_sol.t
X = np.array((x, y))

#create sindy object to train data

dmethod = dmethods(X, t)
diff = dmethod.forward_difference()

theta_instance = theta(X, 2)


#find model with the best lambda:
lbd_guess = np.logspace(-6, 1, 50)
min_err = np.inf
lbd_opt = 0
for lbd in lbd_guess:
    sindy = SINDY(dmethod, theta_instance, X, lbd=lbd)
    model = sindy.model()
    sol = sindy.simulate(t_span, x0, t)
    if sol.success==True:
        solx, soly = sol.y
        if np.any(np.abs(solx) > 1e6) or np.any(np.abs(soly)>1e6):
            continue
        else:
            if np.shape(x) != np.shape(solx) or np.shape(y) != np.shape(soly):
                continue
            else:
                x_err = np.mean((x - solx)**2)
                y_err = np.mean((y - soly)**2)
                total_err = x_err + y_err
                if total_err < min_err:
                    min_err = total_err
                    lbd_opt = lbd
print(f'minimum error: {min_err}, optimal lambda: {lbd_opt}')
