
from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
from PIN_SINDy.Case_Study_C.SINDyPySource import SINDY, theta, dmethods

coef_error_each = True

def true_equation(t, X):
    # define constants:
    sigma = 10
    rho = 28
    beta = 8/3
    alpha = 3/10
    gamma = -1
    kappa = 3/100

    dx = sigma*(X[1]-X[0]) + alpha*X[2]*X[1] - kappa*X[0]**2
    dy = X[0]*(rho - X[2]) - X[1] + gamma*X[2]
    dz = X[0]*X[1] - beta*X[2] - kappa*X[1]
    return np.array([dx, dy, dz])

def prior(t, X):
    sigma = 10
    rho = 28
    beta = 8/3

    dx = sigma*(X[1]-X[0])
    dy = X[0]*(rho - X[2]) - X[1]
    dz = X[0]*X[1] - beta*X[2]

    return np.array([dx, dy, dz])


sigma = 10
rho = 28
beta = 8/3
alpha = 3/10
gamma = -1
kappa = 3/100

true_coef = np.array([[-sigma, sigma, 0, -kappa, 0, 0, 0, alpha, 0],
    [rho, -1, gamma, 0, 0, -1, 0, 0, 0], [0, -kappa, -beta, 0, 1, 0, 0, 0, 0]])
fi = np.array([[-sigma, sigma, 0, 0, 0, 0, 0, 0, 0], [rho, -1, 0, 0, 0, -1, 0, 0, 0],
                       [0, 0, -beta, 0, 1, 0, 0, 0, 0]])


t_span = (0, 20)
t = np.linspace(0, 20, 2000)
y0 = (1, 1, 1)

x, y, z = integrate.solve_ivp(true_equation, t_span, y0, str='LSODA', t_eval=t).y
X = np.array([x, y, z])

#create SINDy model

dmethod = dmethods(X, t)
theta_instance = theta(X, 2)

#generate results:
lbd_space = np.logspace(-8, 1, 100)
zetaPIN = []
pin_error = np.inf
opt_lbd_pin = 0

for lbd in lbd_space:
    sindy_pin = SINDY(dmethod, X, t, t_span, y0, theta_instance=theta_instance, lbd=lbd, regressor="lstsq", norm_optimization=True)
    model_pin = sindy_pin.model(fi)
    sol_pin = sindy_pin.simulate(fi)
    sindy_coef_pin = sindy_pin.get_coef()
    pin_norm = np.linalg.norm(sindy_coef_pin, 2)
    if pin_norm == 0:
        pin_norm == 1
    zeta_term = np.linalg.norm(sindy_coef_pin - true_coef, 2)/ np.linalg.norm(sindy_coef_pin, 2)
    zetaPIN.append(zeta_term)
    if zeta_term <= pin_error:
        pin_error = zeta_term
        opt_lbd_pin = lbd

zetaPIN = np.array(zetaPIN)

zetaSINDY = []
sindy_error = np.inf
opt_lbd_sindy = 0
for lbd in lbd_space:
    sindy = SINDY(dmethod, X, t, t_span, y0, theta_instance=theta_instance, lbd=lbd, regressor="lstsq")
    model = sindy.model()
    sol = sindy.simulate()
    sindy_coef = sindy.get_coef()
    norm = np.linalg.norm(sindy_coef, 2)
    if norm == 0:
        norm == 1
    zeta_term = np.linalg.norm(sindy_coef - true_coef, 2)/norm
    zetaSINDY.append(zeta_term)

    if zeta_term <= sindy_error:
        sindy_error = zeta_term
        opt_lbd_sindy = lbd

zetaSINDY = np.array(zetaSINDY)

plt.rcParams["font.family"] = "serif"

plt.plot(lbd_space, zetaSINDY, label='SINDy error', color='lightcoral')
plt.plot(lbd_space, zetaPIN, label='PIN-SINDy error', color='lightskyblue')
plt.plot(opt_lbd_pin, pin_error, marker='o', markersize=5, color='royalblue')
plt.plot(opt_lbd_sindy, sindy_error, marker='o', markersize=5, color='firebrick')
plt.xscale("log")
plt.xlabel('lambda values')
plt.ylabel('coefficient error')
plt.annotate(
        f'pin min: {pin_error:.3g}\nλ={opt_lbd_pin:.3g}',
        xy=(opt_lbd_pin, pin_error),
        xytext=(15, 25), textcoords='offset points',
        fontsize=8, color='royalblue',
        arrowprops=dict(arrowstyle='->', color='royalblue', lw=1)
    )

plt.annotate(
        f'sindy min: {sindy_error:.3g}\nλ={opt_lbd_sindy:.3g}',
        xy=(opt_lbd_sindy, sindy_error),
        xytext=(-100, 25), textcoords='offset points',
        fontsize=8, color='firebrick',
        arrowprops=dict(arrowstyle='->', color='firebrick', lw=1)
    )



plt.legend()
plt.tight_layout()
plt.show()

