
from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from SINDyPySource import SINDY, theta, dmethods
#determine whether you would like noise or not:
add_noise = False

# instructions: use for optimal PIN-SINDy lambda (1e3) and optimal SINDy lambda (1e-2)

# generate training data:
def true_equation(t, X):
    # define constants:
    sigma = 10
    rho = 28
    beta = 8/3
    alpha = 3/10
    gamma = -1
    kappa = 3/100

    dx = sigma*(X[1]-X[0]) + alpha*X[2]*X[1] - kappa*X[0]**2
    dy = X[0]*(rho - X[2]) - X[1] + gamma*X[2]
    dz = X[0]*X[1] - beta*X[2] - kappa*X[1]
    return np.array([dx, dy, dz])

sigma = 10
rho = 28
beta = 8/3
alpha = 3/10
gamma = -1
kappa = 3/100

true_coef = np.array([[-sigma, sigma, 0, -kappa, 0, 0, 0, alpha, 0],
    [rho, -1, gamma, 0, 0, -1, 0, 0, 0], [0, -kappa, -beta, 0, 1, 0, 0, 0, 0]])
fi = np.array([[-sigma, sigma, 0, 0, 0, 0, 0, 0, 0], [rho, -1, 0, 0, 0, -1, 0, 0, 0],
                       [0, 0, -beta, 0, 1, 0, 0, 0, 0]])


Nlist = np.linspace(4, 2000, 500, dtype=int)


zeta = []
minimum = np.inf
opt_N = 0

for N in Nlist:
    t_span = (0, 20)
    t = np.linspace(0, 20, N)
    y0 = (1, 1, 1)


    x, y, z = integrate.solve_ivp(true_equation, t_span, y0, t_eval=t, method='LSODA').y
    X = np.array([x, y, z])

    dmethod = dmethods(X, t)
    theta_instance = theta(X, 2)
    lbd = 1e-1

    sindy = SINDY(dmethod, theta_instance, X, lbd)
    model = sindy.model(fi)
    sindy_coef = sindy.get_coef()

    zeta_term = np.linalg.norm(sindy_coef - true_coef, 2)/ np.linalg.norm(sindy_coef+fi, 2)
    zeta.append(zeta_term)
    if zeta_term <= minimum:
        minimum = zeta_term
        opt_N = N

zeta = np.array(zeta)

plt.plot(Nlist, zeta)
plt.plot(opt_N, minimum, 'ro')
plt.xlabel('values of N')
plt.ylabel('average coefficient error')
plt.title(f'PIN-SINDy error where lbd ={lbd}. minimum error is {minimum} where time step number is {opt_N}')
plt.tight_layout()
plt.grid()
plt.show()
