# create training data:
def true_forcing(t, x):
    dx = x[0] + x[1] + .2*x[0]**2
    dy = -x[0] + .1*x[1] + x[0]*x[1]
    return [dx, dy]

def prior_forcing(t, x):
    dx = x[0] + x[1]
    dy = -x[0]
    return [dx, dy]

x0 = [2.1, 1]

t = np.linspace(0, 1, 1000)
t_span = (0, 1)

true_sol = integrate.solve_ivp(true_forcing, t_span, x0, method="LSODA", t_eval=t)
x, y = true_sol.y
trueT = true_sol.t
X = np.array((x, y))

#create sindy object to train data

dmethod = dmethods(X, t)
diff = dmethod.forward_difference()

theta_instance = theta(X, 2)

sindy = SINDY(dmethod, theta_instance, X, lbd=.0045)
model = sindy.model()
sol = sindy.simulate(t_span, x0, t)
if not sol.success:
    raise RuntimeError
else:
    solx, soly = sol.y
    print(sindy.get_coef())

#find model with the best lambda:


def best_lbd():
    lbd_guess = np.logspace(-10, 1, 50)
    min_err = np.inf
    lbd_opt = 0
    divergence = []
    inequal_shapes = 0
    for lbd in lbd_guess:
        sindy = SINDY(dmethod, theta_instance, X, lbd=lbd)
        model = sindy.model()
        sol = sindy.simulate(t_span, x0, t)
        if sol.success==True:
            solx, soly = sol.y
            if np.any(np.abs(solx) > 1e6) or np.any(np.abs(soly)>1e6):
                divergence.append(lbd)
                continue
            else:
                if np.shape(x) != np.shape(solx) or np.shape(y) != np.shape(soly):
                    inequal_shapes+= 1
                    continue
                else:
                    x_err = np.mean((x - solx)**2)
                    y_err = np.mean((y - soly)**2)
                    total_err = x_err + y_err
                    if total_err < min_err:
                        min_err = total_err
                        lbd_opt = lbd
    print(f'minimum error: {min_err}, optimal lambda: {lbd_opt}, inequal shapes= {inequal_shapes}, diverging lambdas = {divergence}')
    return{'minimum error': {min_err}, 'optimal_lbd': {lbd_opt}, 'inequal_shapes': {inequal_shapes}, 'diverging_lbds': {divergence}}






