    zs = sol_sindy[0]*np.cos(sol_sindy[1])

    xp = sol_pin[0]*np.cos(sol_pin[2])*np.sin(sol_pin[1])
    yp = sol_pin[0]*np.sin(sol_pin[2])*np.sin(sol_pin[1])
    zp = sol_pin[0]*np.cos(sol_pin[1])


    ax0.plot(xs, ys, zs, label="SINDy model", color="lightcoral")
    ax0.plot(x, y, z, label="actual", linestyle="dashed", color="black")
    ax0.legend()

    ax1.plot(xp, yp, zp, label="PIN-SINDy model", color="lightskyblue")
    ax1.plot(x, y, z, label="actual", linestyle="dashed", color="black")
    ax1.legend()
    plt.tight_layout()
    plt.show()

if plot_error:
