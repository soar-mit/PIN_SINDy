from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from SINDyPySource import SINDY, theta, dmethods
#determine whether you would like noise or not:
add_noise = False

# instructions: use for optimal PIN-SINDy lambda (1e3) and optimal SINDy lambda (1e-2)

# generate training data:
def true_forcing(t, x):
    dx = .5*x[0] - .2*x[0]*x[1] - .1*x[0]**2
    dy = -.3*x[1] + .4*x[0]*x[1] - .1*x[1]**2
    return [dx, dy]


true_coef = np.array([[.5, 0, -.1, -.2, 0], [0, -.3, 0, .4, -.1]])
fi = np.array([[1, 0, 0, -1, 0], [0, -1, 0, 1, 0]])

Nlist = np.linspace(100, 20000, 500, dtype=int)


zeta = []
minimum = np.inf
opt_N = 0

for N in Nlist:
    t_span = (0, 20)
    t = np.linspace(0, 20, N)
    y0 = (5, 7)


    x, y = integrate.solve_ivp(true_forcing, t_span, y0, t_eval=t, method='LSODA').y
    X = np.array([x, y])

    dmethod = dmethods(X, t)
    theta_instance = theta(X, 2)
    lbd = .001

    sindy = SINDY(dmethod, X, t, t_span, y0, theta_instance=theta_instance,  lbd=lbd)
    model = sindy.model(fi)
    coef = sindy.get_coef()

    zeta_term = np.linalg.norm(coef - true_coef, 2)/ np.linalg.norm(coef, 2)
    zeta.append(zeta_term)
    if zeta_term <= minimum:
        minimum = zeta_term
        opt_N = N

zeta = np.array(zeta)


plt.plot(opt_N, minimum, "ro", color="blue")
plt.plot(Nlist, zeta)
plt.xlabel('values of N')
plt.ylabel('average coefficient error')
plt.title(f'PIN-SINDy error where lbd ={lbd}. minimum error is {minimum} where optimal time step number is {opt_N}')
plt.tight_layout()
plt.grid()
plt.show()
