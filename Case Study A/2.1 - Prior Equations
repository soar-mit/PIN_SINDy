from scipy import integrate
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec

### Source Equations:

def true_forcing(t, x):
    dx = x[0] + x[1] + .2*x[0]**2
    dy = -x[0] + .1*x[1] + x[0]*x[1]
    return [dx, dy]

def prior_forcing(t, x):
    dx = x[0] + x[1]
    dy = -x[0]
    return [dx, dy]

x0 = [2.1, 1]

t = np.linspace(0, 1, 100)
t_span = (0, 1)

true_sol = integrate.solve_ivp(true_forcing, t_span, x0, t_eval=t)
trueX, trueY = true_sol.y
trueT = true_sol.t
prior_sol = integrate.solve_ivp(prior_forcing, t_span, x0, t_eval=t)
priorX, priorY = prior_sol.y
priorT = prior_sol.t

plt.rcParams["font.family"] = "serif"

fig = plt.figure()
axs = GridSpec(2, 2, width_ratios=[1, 1])
axs1 = fig.add_subplot(axs[0, 1])
axs2= fig.add_subplot(axs[1, 1], sharex=axs1)
axs3 = fig.add_subplot(axs[:, 0])


axs1.plot(trueT, trueX, 'k-', label='true equations')
axs1.plot(priorT, priorX, 'b-', label='prior equations')
axs1.set_ylabel("x")
axs1.set_ylim((2.5, 8))
axs1.set_xlim((0, 1))

axs2.plot(trueT, trueY, 'k-')
axs2.plot(priorT, priorY, 'b-')
axs2.set_ylim((-1, 2.5))
axs2.set_ylabel("y")


fig.supxlabel("t")

axs3.plot(trueX, trueY, 'k-', label="true equations")
axs3.plot(priorX, priorY, 'b-', label="prior equations")
axs3.set_ylabel("y")
axs3.set_xlabel("x")
axs3.set_ylim((-1, 2.5))
axs3.set_xlim((0, 8.5))

plt.legend()
plt.tight_layout()
plt.show()
