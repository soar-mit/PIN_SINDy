if opt_lbd_sim == True:
    lbds = np.logspace(-3, 0, 50)
    lbds = list(lbds)
    lbds_copy = lbds.copy()
    zeta_sindy = []
    zeta_pin = []

    min_error_sindy = np.inf
    opt_lbd_sindy = 0

    min_error_pin = np.inf
    opt_lbd_pin = 0

    thet[thet==0] = 1
    phi[phi==0] = 1


    for lbd in lbds:
        sindy_l2 = SINDY(dmethod, X[3:], t_eval=t, t_span=t_span, u0=X0, theta_instance=None, custom_lib=theta_lib,
                         norm_optimization=False, lbd=lbd, derivative="second derivative second order", regressor="lstsq")
        coef_sindy_l2 = sindy_l2.model()['coef']
        coef_pin_l2 = sindy_l2.model(fi)['coef']

        sim_l2 = simulate_orbit(coef_sindy_l2, coef_pin_l2)
        sr, sthet, sphi = sim_l2["sindy"][:3]
        pr, pthet, pphi = sim_l2["pin"][:3]

        if len(sr) == len(r):
            sr_error = np.average(np.abs((sr-r)/r))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(pr) == len(r):
            pr_error = np.average(np.abs((pr - r)/r))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(sthet) == len(thet):
            sthet_error = np.average(np.abs((sthet-thet)/thet))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(pthet) == len(thet):
            pthet_error = np.average(np.abs((pthet - thet)/thet))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(sphi) == len(phi):
            sphi_error = np.average(np.abs((sphi-phi)/phi))
        else:
            lbds_copy.remove(lbd)
            continue

        if len(pphi) == len(phi):
            pphi_error = np.average(np.abs((pphi - phi)/phi))
        else:
            lbds_copy.remove(lbd)
            continue


        s_error = np.average([sr_error, sthet_error, sphi_error])
        zeta_sindy.append(s_error)

        p_error = np.average([pr_error, pthet_error, pphi_error])
        zeta_pin.append(p_error)

        if s_error <= min_error_sindy:
                min_error_sindy = s_error
                opt_lbd_sindy = lbd

        if p_error <= min_error_pin:
                min_error_pin = p_error
                opt_lbd_pin = lbd

    zeta_sindy = np.array(zeta_sindy)
    zeta_pin = np.array(zeta_pin)

    plt.plot(lbds_copy, zeta_sindy, color="lightcoral")
    plt.plot(opt_lbd_sindy, min_error_sindy, marker='o', markersize=5, color="firebrick")
    plt.xscale('log')
    plt.ylabel('average model error.')

    plt.plot(lbds_copy, zeta_pin, color="lightskyblue")
    plt.plot(opt_lbd_pin, min_error_pin, marker='o', markersize=5, color="royalblue")
    plt.xlabel('lambda values')

    plt.annotate(
            f'pin min: {min_error_pin:.3g}\nλ={opt_lbd_pin:.3g}',
            xy=(opt_lbd_pin, min_error_pin),
            xytext=(-100, 25), textcoords='offset points',
            fontsize=8, color='royalblue',
            arrowprops=dict(arrowstyle='->', color='royalblue', lw=1)
        )
    plt.annotate(
                f'sindy min: {min_error_sindy:.3g}\nλ={opt_lbd_sindy:.3g}',
                xy=(opt_lbd_sindy, min_error_sindy),
                xytext=(15, 25), textcoords='offset points',
                fontsize=8, color='firebrick',
                arrowprops=dict(arrowstyle='->', color='firebrick', lw=1)
            )

    plt.show()

