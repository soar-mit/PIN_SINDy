# create model and plot results

def simulate_orbit(coef_s, coef_p):

    I = 3
    K = 3
    pwrs = []
    for k in range(K+1):
            for powers in itertools.combinations_with_replacement(range(I), k):
                pwr = [0]*I
                for i in powers:
                    pwr[i] += 1
                pwrs.append(pwr)

    pwrs = np.array(pwrs)
    pwrs.astype(np.float64)

    def sindy_model(t, X):

        x = X[0]
        y = X[1]
        z = X[2]

        theta_lib_r3 = []
        binomial_terms = []

        r = np.array([X[0], X[1], X[2]])
        rmag = np.linalg.norm(r, axis=0)

        for p in pwrs:
            assert len(p) == len(r), "oops! recalculate theta library."
            term = 1.0
            for i in range(3):
                term *= X[i]**p[i]

            theta_lib_r3.append(term/rmag**3)

        theta_lib_r3 = np.array(theta_lib_r3)
        theta_lib_r3 = theta_lib_r3[1:4]

        binomial_terms.append(x*(5*z**2/rmag**2 - 1)/rmag**5)
        binomial_terms.append(y*(5*z**2/rmag**2 - 1)/rmag**5)
        binomial_terms.append(z*(5*z**2/rmag**2 - 3)/rmag**5)
        binomial_terms = np.array(binomial_terms)

        theta_vec = np.concatenate([theta_lib_r3, binomial_terms])

        forcing = np.array([np.dot(coef_s[i, :], theta_vec) for i in range(0, 3)])

        return [X[3], X[4], X[5], forcing[0], forcing[1], forcing[2]]

    sol_sindy = integrate.solve_ivp(sindy_model, t_span, X0, method="RK45", t_eval=t).y

    def pin_model(t, X):
        x = X[0]
        y = X[1]
        z = X[2]

        theta_lib_r3 = []
        binomial_terms = []

        r = np.array([X[0], X[1], X[2]])
        rmag = np.linalg.norm(r, axis=0)

        for p in pwrs:
            assert len(p) == len(r), "oops! recalculate theta library."
            term = 1.0
            for i in range(3):
                term *= X[i]**p[i]

            theta_lib_r3.append(term/rmag**3)

        theta_lib_r3 = np.array(theta_lib_r3)
        theta_lib_r3 = theta_lib_r3[1:4]

        binomial_terms.append(x*(5*z**2/rmag**2 - 1)/rmag**5)
        binomial_terms.append(y*(5*z**2/rmag**2 - 1)/rmag**5)
        binomial_terms.append(z*(5*z**2/rmag**2 - 3)/rmag**5)

        theta_vec = np.concatenate([theta_lib_r3, binomial_terms])


        forcing = np.array([np.dot(coef_p[i, :], theta_vec) for i in range(0, 3)])

        return [X[3], X[4], X[5], forcing[0], forcing[1], forcing[2]]


    sol_pin = integrate.solve_ivp(pin_model, t_span, X0, method="RK45", t_eval=t).y

    return {"sindy":sol_sindy, "pin":sol_pin}

